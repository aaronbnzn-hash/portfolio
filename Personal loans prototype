  const HO_CHECK = '<svg width="13" height="10" viewBox="0 0 14 11" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1.2 5.6 5 9.4 12.8 1.6"/></svg>';
  const HO_CLOCK = '<svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round"><circle cx="7" cy="7" r="5.6"/><path d="M7 4.2V7l1.9 1.4"/></svg>';
  let hoTick = null;

  function hoPaint(p){                       // p = 0..1
    const name = J.lender ? ctaName(J.lender) : 'the lender';
    const left = Math.max(0, Math.ceil(HANDOFF_MS * (1 - p) / 1000));
    document.getElementById('hoTimer').textContent =
      '00:' + String(left).padStart(2, '0');
    document.getElementById('hoArc').style.strokeDashoffset = (163.4 * (1 - p)).toFixed(1);

    const stage = HO_STEPS.reduce((n, s, i) => p >= s.at ? i : n, 0);
    document.getElementById('hoPill').textContent = HO_STEPS[stage].pill.replace('%s', name);
    [...document.getElementById('hoSteps').children].forEach((li, i) => {
      const done = i < stage || p >= 1, live = i === stage && p < 1;
      li.classList.toggle('is-done', done);
      li.classList.toggle('is-live', live);
      li.querySelector('.ho-ic').innerHTML = done ? HO_CHECK : live ? HO_CLOCK : '';
      li.querySelector('em').innerHTML = done ? 'Done'
        : live ? '<span class="ho-spin">' + Array.from({length:8},(_,k)=>'<i style="transform:rotate('+(k*45)+'deg);opacity:'+(.25+k*.09)+'"></i>').join('') + '</span>'
        : '';
    });
    hoTip(Math.min(HO_TIPS.length - 1, Math.floor(p * HO_TIPS.length)));
    // the dots travel from Blostem to the lender as the transfer progresses
    document.querySelectorAll('.ho-dots').forEach((d, side) => {
      [...d.children].forEach((dot, k) => {
        const at = (side * 5 + k + 1) / 10;
        dot.classList.toggle('on', p >= at * 0.9);
      });
    });
  }


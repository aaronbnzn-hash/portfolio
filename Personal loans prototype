/* enough room either side of the phone to hold both rails */
@media (min-width:1080px){
  body.lender-on .prail{display:block}
  body.lender-on .j-foot,
body.lender-on .lf-pre,
body.lender-on .lf-bar{display:none}     /* Next lives in the rail instead */

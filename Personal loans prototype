.tl-sheet.open{transform:translate(-50%,0)}
.tl-sheet .grip{width:44px;height:5px;border-radius:5px;background:#C9CFD8;margin:0 auto 14px}
.tl-head{display:flex;align-items:flex-start;gap:10px}
.tl-head div{flex:1;min-width:0}
.tl-head h3{margin:0;font-size:21px;font-weight:800;letter-spacing:-.02em;color:#0F1E33}
.tl-head p{margin:4px 0 0;font-size:12.5px;color:#8A93A8}
.tl-x{width:28px;height:28px;flex:0 0 auto;border-radius:50%;display:grid;place-items:center;background:#F1F3F8}
.tl-list{margin-top:14px;max-height:min(52vh,420px);overflow-y:auto;padding-right:2px}
.tl-row{

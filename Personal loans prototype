  /* ---------------- sliders + EMI ---------------- */
  const inr = n => '₹' + Math.round(n).toLocaleString('en-IN');
  const state = { amount:1000000, tenure:36, rate:12.4 };
  const CFG = {
    amount:{ min:100000, max:2000000, step:10000, out:'amountVal', fmt:v => inr(v) },
    tenure:{ min:6,      max:60,      step:1,     out:'tenureVal', fmt:v => v + ' months' },
    rate:  { min:8,      max:24,      step:0.1,   out:'rateVal',   fmt:v => v.toFixed(1) + '%' }
  };

  function emi(P, months, annual){
    const r = annual / 12 / 100;
    if (r === 0) return P / months;
    const f = Math.pow(1 + r, months);
    return P * r * f / (f - 1);
  }

  function paint(){
    for (const key in CFG){
      const c = CFG[key], v = state[key];
      const pct = (v - c.min) / (c.max - c.min);
      const box = document.querySelector(`[data-slider="${key}"]`);
      box.querySelector('.hfill').style.width = (pct * 100) + '%';
      const knob = box.querySelector('.hknob');
      knob.style.left = (pct * 100) + '%';
      knob.setAttribute('aria-valuenow', v);
      knob.setAttribute('aria-valuetext', c.fmt(v));
      document.getElementById(c.out).textContent = c.fmt(v);
    }
    const e = emi(state.amount, state.tenure, state.rate);
    document.getElementById('emiValue').textContent = inr(e);
    renderLenders(state.amount, state.tenure);
    if (dockReady) paintDock();   // the dock is wired later in the script
  }

  function setValue(key, raw){
    const c = CFG[key];
    let v = Math.min(c.max, Math.max(c.min, raw));
    v = Math.round(v / c.step) * c.step;
    v = Math.min(c.max, Math.max(c.min, v));
    state[key] = key === 'rate' ? Math.round(v * 10) / 10 : v;
    paint();
  }

  document.querySelectorAll('[data-slider]').forEach(box => {
    const key = box.dataset.slider, c = CFG[key];
    const track = box.querySelector('.htrack');
    const knob = box.querySelector('.hknob');

    const fromEvent = ev => {
      const r = track.getBoundingClientRect();
      const pct = (ev.clientX - r.left) / r.width;
      setValue(key, c.min + pct * (c.max - c.min));
    };
    const onMove = ev => { ev.preventDefault(); fromEvent(ev); };
    const onUp = ev => {
      window.removeEventListener('pointermove', onMove);
      window.removeEventListener('pointerup', onUp);
      if (knob.hasPointerCapture?.(ev.pointerId)) knob.releasePointerCapture(ev.pointerId);
    };
    const onDown = ev => {
      ev.preventDefault();
      knob.focus();
      knob.setPointerCapture?.(ev.pointerId);
      fromEvent(ev);
      window.addEventListener('pointermove', onMove, {passive:false});
      window.addEventListener('pointerup', onUp);
    };
    box.addEventListener('pointerdown', onDown);   // whole 20px strip is grabbable, not just the 4px track

    knob.addEventListener('keydown', ev => {
      const big = c.step * 10;
      const moves = {ArrowUp:c.step, ArrowRight:c.step, ArrowDown:-c.step, ArrowLeft:-c.step, PageUp:big, PageDown:-big};
      if (ev.key in moves){ ev.preventDefault(); setValue(key, state[key] + moves[ev.key]); }
      else if (ev.key === 'Home'){ ev.preventDefault(); setValue(key, c.min); }
      else if (ev.key === 'End'){  ev.preventDefault(); setValue(key, c.max); }
    });
  });


.j-view .ho-title{margin:20px 0 0;font-size:25px;font-weight:800;letter-spacing:-.03em;line-height:1.2;text-align:center}
.ho-sub{margin:10px 0 0;font-size:14.5px;line-height:1.5;color:#6B7488;text-align:center}
.ho-sub b{color:#3F4A5E;font-weight:700}

.ho-stage{
  position:relative;overflow:hidden;isolation:isolate;
  margin-top:18px;padding:24px 16px 20px;border-radius:20px;text-align:center;
  border:1.5px solid #EDF1F9;
  background:linear-gradient(140deg,var(--hero-a) 0%,var(--hero-b) 42%,var(--hero-c) 100%);
}
.ho-aurora{position:absolute;inset:0;z-index:-1;pointer-events:none;overflow:hidden;border-radius:inherit}
.ho-aurora i{position:absolute;border-radius:50%;filter:blur(26px);opacity:.55}
.ho-aurora i:nth-child(1){width:150px;height:150px;left:-30px;bottom:-56px;background:var(--acct-glow);animation:hoDrift 9s ease-in-out infinite}
.ho-aurora i:nth-child(2){width:130px;height:130px;right:-26px;bottom:-46px;background:var(--brand-glow);animation:hoDrift 11s ease-in-out infinite reverse}
.ho-aurora i:nth-child(3){width:110px;height:110px;left:44%;top:-52px;background:var(--acct-glow-2);animation:hoDrift 13s ease-in-out infinite}
@keyframes hoDrift{0%,100%{transform:translate3d(0,0,0) scale(1)}50%{transform:translate3d(14px,-12px,0) scale(1.12)}}
.ho-stage::after{
  content:"";position:absolute;top:0;bottom:0;width:45%;left:-60%;pointer-events:none;
  background:linear-gradient(100deg,transparent,rgba(255,255,255,.65),transparent);
  animation:hoSheen 3.4s ease-in-out infinite;
}
@keyframes hoSheen{0%{left:-60%}60%,100%{left:120%}}
.ho-flow,.ho-timer,.ho-pill{position:relative;z-index:1}
.ho-flow{display:flex;align-items:flex-start;justify-content:center;gap:6px}
.ho-end{width:66px;flex:0 0 auto}
.ho-av{
  width:52px;height:52px;border-radius:50%;margin:0 auto;overflow:hidden;
  display:grid;place-items:center;color:#fff;font-size:19px;font-weight:800;
  box-shadow:0 6px 16px rgba(14,26,56,.18);
}
.ho-av svg{width:100%;height:100%;display:block}
.ho-blostem{background:var(--ho-blue)}
.ho-end em{
  display:block;margin-top:8px;font-style:normal;font-size:11.5px;
  font-weight:600;color:#5A6478;
}
.ho-dots{flex:1 1 0;display:flex;align-items:center;gap:5px;justify-content:center;margin-top:24px}
.ho-dots i{width:4px;height:4px;border-radius:50%;background:#B9C2D6;opacity:.5;transition:opacity .3s ease}
.ho-dots i.on{opacity:1}
.ho-dots.to i.on{background:var(--brand)}
.ho-dots.from i.on{background:var(--ho-blue)}
.ho-lock{position:relative;width:58px;height:58px;flex:0 0 auto;margin-top:-2px}
.ho-lock::before{
  content:"";position:absolute;inset:-6px;border-radius:50%;
  background:radial-gradient(circle,rgba(var(--acct-rgb),.20),transparent 70%);
  animation:hoBreathe 2.2s ease-in-out infinite;
}
@keyframes hoBreathe{0%,100%{transform:scale(.9);opacity:.55}50%{transform:scale(1.08);opacity:1}}
.ho-lock .core,.ho-lock svg.arc{position:absolute;z-index:1}
.ho-lock svg.arc{position:absolute;inset:0;transform:rotate(-90deg)}
.ho-lock .core{
  position:absolute;inset:8px;border-radius:50%;background:#fff;
  display:grid;place-items:center;box-shadow:0 4px 12px rgba(14,26,56,.12);
}
.ho-timer{
  margin-top:16px;font-size:29px;transition:color .3s ease;font-weight:800;letter-spacing:-.02em;
  color:var(--ink);font-variant-numeric:tabular-nums;
}
.ho-pill{
  display:inline-flex;align-items:center;gap:7px;margin-top:12px;

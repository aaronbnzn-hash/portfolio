.j-legal label{font-size:11.5px;line-height:1.5;color:#8A93A5;cursor:pointer}
.j-legal b{font-weight:600;color:#5A6478}
.j-legal a{color:var(--orange);font-weight:600;text-decoration:underline;text-underline-offset:2px}

/* "is this you" — fetched PAN card */
.pan-card{
  position:relative;overflow:hidden;
  margin-top:24px;padding:22px 24px;border-radius:12px;
  aspect-ratio:1.73/1;
  background:linear-gradient(135deg,#9CC1EC 0%,#8DB4E5 48%,#A9CCF1 100%);
  box-shadow:0 12px 26px rgba(20,60,120,.2);
}
.pan-card::before{
  content:"";position:absolute;inset:-40% -20%;pointer-events:none;opacity:.3;
  background:repeating-radial-gradient(circle at 30% 48%,rgba(255,255,255,.55) 0 .6px,transparent .6px 4.5px);
}
.pan-card > *{position:relative;z-index:1}
.pc-label{display:block;font-size:12.5px;font-weight:500;color:#1B4A8C}
.pc-value{display:block;margin:1px 0 14px;font-size:19px;font-weight:800;color:#0A1B33;letter-spacing:.01em}
.pc-value:last-of-type{margin-bottom:0}
.pan-lines{position:absolute;top:28px;right:24px;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.pan-lines i{height:1.5px;border-radius:2px;background:rgba(20,60,120,.4)}
.pan-lines i:nth-child(1){width:108px}
.pan-lines i:nth-child(2){width:88px}
.pan-lines i:nth-child(3){width:60px}
.pan-holo{
  position:absolute;right:24px;bottom:30px;width:84px;height:84px;border-radius:10px;
  display:grid;place-items:center;font-size:17px;font-weight:800;color:#1B4A8C;letter-spacing:.02em;
  background:
    repeating-radial-gradient(circle at 46% 54%,rgba(255,255,255,.45) 0 .6px,transparent .6px 4px),
    linear-gradient(135deg,#C9C4EC 0%,#B7CDEE 50%,#CFC8EE 100%);
  box-shadow:inset 0 0 0 1px rgba(255,255,255,.4);
}
/* the verified mobile, as a chip beside the heading - tap to change it (new OTP) */
.confirm-head{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 12px;margin-top:58px}
.confirm-head h1{margin:0}
.cont-with{display:inline-flex;align-items:center;gap:6px;padding:7px 12px 7px 10px;border-radius:999px;background:#F6F7F9;border:1px solid #EDEFF3;font:inherit;font-size:12.5px;line-height:1;color:#0F1E33;cursor:pointer}
.cont-with .cw-ic{flex:none;color:#5A6478}
.cont-with b{font-weight:600;white-space:nowrap}
.cont-with .cw-sep{width:1px;height:12px;background:#D9DDE5;margin:0 2px}
.cont-with .cw-edit{display:inline-flex;align-items:center;gap:3px;font-weight:600;color:var(--brand)}
.not-you{margin:26px 0 0;text-align:center;font-size:14.5px;color:#7A8496}
.not-you button{color:var(--orange);font-weight:700;text-decoration:underline;text-underline-offset:3px}

/* details + address forms */
.j-view h2{margin:0;font-size:21px;font-weight:800;letter-spacing:-.03em}
.f-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:40px}
.badge-req{
  flex:0 0 auto;padding:6px 12px;border-radius:999px;
  background:var(--brand-tint);color:var(--orange);font-size:11px;font-weight:600;
}
.f-label{display:block;margin:16px 0 7px;font-size:12.5px;font-weight:600;color:#8A93A5}
.f-input{
  display:flex;align-items:center;gap:12px;height:48px;padding:0 15px;
  background:#fff;border:1.5px solid #E2E5EA;border-radius:12px;
  transition:border-color .18s ease;
}
.f-input:focus-within,.f-input.is-busy{border-color:var(--orange)}
.f-input input{
  flex:1;min-width:0;border:0;outline:0;background:none;font-family:inherit;
  font-size:14.5px;font-weight:500;color:#0F1E33;
}
.f-input .pre{font-size:14.5px;color:#8A93A5;font-weight:500}
.f-input .bar{width:1.5px;height:20px;background:#E2E5EA;flex:0 0 auto;margin-left:-4px}
.f-help{margin:7px 0 0;font-size:11.5px;color:#96A0B0}
.f-look{margin:6px 0 0;min-height:15px;font-size:11.5px;font-weight:500;color:var(--orange)}
/* ---------- guided form: one question at a time ---------- */
body.guide-on .f-section{display:none}
body:not(.guide-on) .gd-done,
body:not(.guide-on) .gs-found,
body:not(.guide-on) .gs-ic,
body:not(.guide-on) .gs-q{display:none}
/* the answer just banked — one row, never a pile */
.gd-done{margin-top:20px}
.gd-done:empty{display:none}
.gd-row{display:flex;align-items:center;gap:12px;width:100%;padding:13px 15px;
  border-radius:16px;background:#fff;border:1.5px solid #EDF0F6;text-align:left;
  box-shadow:0 3px 12px rgba(14,26,56,.045);
  animation:gdIn .4s cubic-bezier(.2,.8,.25,1) both}
.gd-row:active{background:#F7F9FD}
.gd-row > i{flex:none;width:23px;height:23px;border-radius:50%;background:var(--green);
  display:grid;place-items:center;animation:tickPop .44s cubic-bezier(.2,.9,.3,1.35) both}
.gd-row > i path{stroke-dasharray:26;stroke-dashoffset:26;
  animation:tickDraw .34s .18s cubic-bezier(.4,0,.2,1) forwards}
.gd-row .k{flex:0 0 auto;font-size:12.5px;font-weight:600;color:var(--muted-2)}
.gd-row .v{flex:1;min-width:0;text-align:right;font-size:13.5px;font-weight:700;color:var(--ink);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gd-row .e{flex:none;font-size:11.5px;font-weight:700;color:var(--brand)}
@keyframes gdIn{from{opacity:0;transform:translateY(-7px)}to{opacity:1;transform:none}}
@keyframes tickPop{0%{transform:scale(.3);opacity:0}55%{transform:scale(1.18);opacity:1}100%{transform:scale(1)}}
@keyframes tickDraw{to{stroke-dashoffset:0}}
/* the question in play */
.gs{display:none}
.gs.on{display:block;animation:gsIn .34s cubic-bezier(.2,.8,.25,1) both}
@keyframes gsIn{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
/* the question and its icon read as one line, not two stacked bands */
.gs-head{display:flex;align-items:center;gap:13px;margin-top:30px}
.gs-ic{flex:none;display:grid;place-items:center;width:42px;height:42px;
  border-radius:14px;background:var(--brand-tint);color:var(--brand)}
.gs-q{margin:0;font-size:21px;font-weight:800;letter-spacing:-.035em;color:var(--ink);line-height:1.2}
body.guide-on .gs .f-input{height:54px;border-radius:14px;margin-top:16px}
body.guide-on .gs .f-input:focus-within{box-shadow:0 0 0 4px rgba(255,107,53,.09)}
/* the screen title steps back — the stepper already says which step this is */
body.guide-on .f-head{margin-top:30px}
body.guide-on .f-head h2{font-size:11.5px;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;color:var(--muted-2)}
/* PIN look-up: one quiet line instead of two labelled boxes */
body.guide-on #placeRow .f-input{height:48px;margin-top:6px}
body.guide-on #placeRow{gap:10px;margin-top:14px}
body.guide-on .gs .f-label{display:none}
body.guide-on #placeRow .f-label{display:block;margin-top:0}
body.guide-on .gs .chips{margin-top:14px}
body.guide-on .gs .chip{padding:12px 16px;font-size:14px}
/* PIN -> city and state: the one place the form gives something back */
.gs-found{display:none;align-items:center;gap:10px;margin-top:14px;padding:13px 15px;
  border-radius:14px;background:#F1FAF3;border:1.5px solid #D6EFDF}
.gs-found b{flex:1;min-width:0;font-size:14px;font-weight:700;color:var(--ink);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.gs-found button{flex:none;font-size:12px;font-weight:700;color:var(--brand)}
body.guide-on .gs-found.on{display:flex;animation:gdIn .34s cubic-bezier(.2,.8,.25,1) both}
body.guide-on #placeRow{display:none}
body.guide-on #placeRow.on{display:flex;animation:gdIn .38s cubic-bezier(.2,.8,.25,1) both}
.f-section{margin:24px 0 0;font-size:19px;font-weight:800;letter-spacing:-.03em;color:#0F1E33}
.f-row{display:flex;gap:12px}
.f-col{flex:1 1 0;min-width:0}

/* "how much do you need" — amount + tenure */
.ask-card{
  margin-top:16px;padding:16px 16px 14px;border-radius:14px;
  background:#F6F7F9;border:1px solid #EDEFF3;
}
.ask-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
.ask-step{
  width:36px;height:36px;border-radius:50%;flex:0 0 auto;
  background:#fff;border:1px solid #E6E9EF;box-shadow:0 2px 6px rgba(15,30,80,.06);
  font-size:20px;font-weight:500;color:#3F4A5E;line-height:1;
}
.ask-step[disabled]{opacity:.4}
.ask-amount{flex:1 1 auto;text-align:center;font-size:26px;font-weight:800;letter-spacing:-.03em;color:#0F1E33}
.ask-row{display:flex;align-items:center;justify-content:space-between;gap:12px}
.ask-row .k{font-size:16px;font-weight:700;letter-spacing:-.02em;color:#0F1E33}
.ask-row .v{font-size:14px;font-weight:500;color:#4A5568}
.ask-ends{display:flex;justify-content:space-between;margin-top:9px;font-size:11.5px;font-weight:500;color:#98A0B0}

.oslider{position:relative;height:20px;margin-top:14px;touch-action:none;cursor:pointer}
.otrack{
  position:absolute;left:0;right:0;top:50%;height:4px;margin-top:-2px;
  border-radius:4px;background:#E3E6EC;
}
.ofill{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:var(--orange)}
.oknob{
  position:absolute;top:50%;width:19px;height:19px;margin:-9.5px 0 0 -9.5px;
  border-radius:50%;background:#fff;border:3px solid var(--orange);
  box-shadow:0 2px 5px rgba(var(--brand-rgb),.35);touch-action:none;
}
.oknob:focus-visible{outline:3px solid rgba(var(--brand-rgb),.35);outline-offset:3px}

.emi-strip{
  margin-top:14px;padding:14px 16px 15px;border-radius:14px;
  background:#F6F7F9;border:1px solid #EDEFF3;text-align:center;
}
.emi-strip .head{
  display:block;white-space:nowrap;
  font-size:12px;font-weight:600;color:var(--orange);
}
.emi-strip .head svg{vertical-align:-1px;margin-right:5px}
.emi-strip .cols{display:flex;justify-content:space-between;gap:12px;margin-top:11px;text-align:left}
.emi-strip .cols div:last-child{text-align:right}
.emi-strip .cols span{display:block;font-size:11.5px;font-weight:500;color:#8A93A5}

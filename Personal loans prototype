  background:var(--brand);box-shadow:0 0 0 2px #fff;
}
.tl-scrim{
  position:fixed;inset:0;z-index:400;background:rgba(0,0,0,.45);
  opacity:0;pointer-events:none;transition:opacity .28s ease;
}
.tl-scrim.open{opacity:1;pointer-events:auto}
.tl-sheet{
  position:fixed;left:50%;bottom:0;z-index:401;
  width:min(100%,430px);margin-left:min(0px,0px);transform:translate(-50%,100%);

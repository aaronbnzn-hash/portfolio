/* ============================================================
   APPLICATION JOURNEY  (verify → details → credit → offers)
   ============================================================ */
body.j-open{overflow:hidden}
body.j-open .drawer{display:none}

.journey{
  position:fixed;top:0;bottom:0;left:50%;transform:translateX(-50%);

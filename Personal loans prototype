.j-ghost{
  width:100%;margin-top:10px;padding:12px;font-size:15px;font-weight:600;color:#5A6478;
}
.j-ghost[hidden]{display:none}
.j-legal{display:flex;align-items:flex-start;gap:11px;margin:0 0 12px;text-align:left}
.j-legal[hidden]{display:none}
.j-legal input{

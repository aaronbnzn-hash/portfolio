}

.ho-steps{list-style:none;margin:14px 0 0;padding:6px 4px;border-radius:16px;background:#fff;border:1.5px solid #EEF0F6}
.ho-steps li{display:flex;align-items:center;gap:12px;padding:13px 12px}
.ho-steps li + li{border-top:1px solid #F1F3F8}
.ho-steps span{flex:1;min-width:0;font-size:14px;font-weight:500;color:#3F4A5E}
.ho-steps em{flex:0 0 auto;font-style:normal;font-size:12.5px;font-weight:700}
.ho-ic{
  width:26px;height:26px;border-radius:50%;flex:0 0 auto;

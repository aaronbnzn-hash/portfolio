  function hoTip(i){
    if (i === hoTipAt) return;
    hoTipAt = i;
    const el = document.getElementById('hoTipText');
    el.classList.add('fade');
    setTimeout(() => { el.textContent = HO_TIPS[i]; el.classList.remove('fade'); }, 220);

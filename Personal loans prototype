  display:grid;place-items:center;
}
.kfs-doc-in{text-align:center;transition:transform .18s ease;will-change:transform}
.kfs-doc-t{margin:14px 0 0;font-size:14px;font-weight:700;color:#8A93A8}
.kfs-doc-s{margin:6px 0 0;font-size:12px;font-weight:400;color:#A8AEBD}
.kfs-zoom{
  position:absolute;right:10px;bottom:10px;z-index:2;

<style>
:root{
  --brand:#FF6B35;        /* primary orange, sampled from the Figma board */
  --brand-deep:#F0561A;
  --brand-light:#FF7F52;
  --brand-tint:#FFF0E9;   /* icon tiles, soft pills */
  --brand-tint-2:#FFE3D6;
  --ho-blue:#1D6AE5;
  --lj:#1B54D6;           /* the hand-off lender brand */      /* hand-off accents */
  --acct:#0D44D2;         /* account / post-disbursal screens, sampled off the board */
  --acct-deep:#06329B;
  --navy:#0B1B3F;
  --ink:#0E1A38;
  --bg:#F4F4FB;
  --muted:#6B7794;
  --muted-2:#8A93A8;
  --line:#E7EBF3;
  --green:#22A85A;
  --orange:#FF6B35;
  --slab:#1B1F40;
  --slab-sub:#8E97C4;
  /* ---- theme lab: every value below is rewritten by applyTheme() ---- */
  --font:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',sans-serif;
  --on-brand:#FFFFFF;      /* text on a brand-filled button - not always white */
  --radius:999px;          /* button corner radius */
  --brand-rgb:255,107,53;  /* for the brand-tinted shadows */
  --acct-rgb:27,77,240;
  --acct-mid:#2E6BF0;
  --acct-soft:#EEF3FE;
  --acct-soft-2:#EAF0FE;
  --acct-line:#E3E9F4;
  --acct-cap:#BACAF6;      /* captions on the dark total card */
  --acct-foot:#9DB3F0;
  --acct-glow:#BBD3FB;     /* hand-off aurora */
  --acct-glow-2:#D8E4FD;
  --acct-dot:#CBD9F4;
  --brand-glow:#FFD3BB;
  --note:#F1F4FB;         /* the lender-payment note */
  --note-2:#E9EAEE;       /* the in-journey info block */
  --canvas:#E9ECF4;        /* outer page */
  --surf-a:#F7F8FC;        /* hero block */
  --surf-b:#EFF2F9;
  --hero-a:#FBFCFF;        /* marketplace wash */
  --hero-b:#F2F5FE;
  --hero-c:#FDF3EE;
  --foot:#F2F3F5;
  --shadow-card:0 10px 30px rgba(15,30,80,.08);
  --sb:48px;              /* status bar, pinned */
  --dr:78px;              /* bottom drawer, fixed */
  --screen:calc(100vh - var(--sb) - var(--dr));
  --screen:calc(100dvh - var(--sb) - var(--dr));
}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:var(--font);
  background:var(--canvas);
  color:var(--ink);
  -webkit-font-smoothing:antialiased;
}
button{font-family:inherit;border:0;background:none;cursor:pointer;color:inherit}

/* ---------- phone shell ---------- */
.phone{
  position:relative;
  width:min(100%,430px);
  margin:0 auto;
  min-height:100vh;
  background:var(--bg);
  overflow-x:hidden;
}
.statusbar{
  position:sticky;top:0;z-index:60;
  display:flex;align-items:center;justify-content:space-between;
  padding:19px 24px 11px;
  background:var(--bg);
  font-size:17.5px;font-weight:700;letter-spacing:-.02em;
}
.statusbar .icons{display:flex;align-items:center;gap:7px}
main{padding-bottom:var(--dr)}

/* continuous scroll: sections take their natural height, per the Figma board */
main > section{
  display:flex;flex-direction:column;justify-content:center;
}


/* ---------- section 1 : hero ---------- */
.hero{
  position:relative;
  padding:16px 20px 10px;
  background:linear-gradient(180deg,var(--surf-a) 0%,var(--surf-b) 100%);
  overflow:hidden;
}
.hero > .hero-wallet{        /* beats the later .hero > * {position:relative} */
  position:absolute;top:6px;right:22px;z-index:3;
  width:42px;height:42px;border-radius:13px;
  display:grid;place-items:center;
  transition:background .18s ease;
}
.hero > .hero-wallet:active{background:rgba(15,30,51,.06)}
.hero::before,.hero::after{
  content:"";position:absolute;border-radius:50%;
  background:radial-gradient(circle at 30% 30%,#DFE6FA,#EDF1FA 70%);
  opacity:.85;pointer-events:none;
}
.hero::before{width:230px;height:230px;top:-70px;right:-80px}
.hero::after{width:200px;height:200px;bottom:60px;left:-90px}
.hero > *{position:relative;z-index:1}
.hero h1{
  margin:4px 0 0;text-align:center;
  font-size:35px;line-height:1.14;font-weight:800;letter-spacing:-.03em;color:#0A1633;
}
.hero .lede{
  margin:12px auto 0;max-width:320px;text-align:center;
  font-size:15.5px;line-height:1.5;font-weight:400;color:#6E7893;
}

/* carousel */
.carousel{
  position:relative;
  flex:0 0 auto;height:290px;
  margin:14px -20px 2px;
  perspective:1200px;
}
.stage{position:absolute;inset:0}
.offer{
  position:absolute;top:14px;left:50%;
  width:164px;height:250px;
  margin-left:-82px;
  border-radius:24px;
  padding:9px;
  background:var(--grad);
  box-shadow:0 14px 34px rgba(14,26,56,.16);
  transition:transform .4s cubic-bezier(.3,.75,.28,1),opacity .4s ease,box-shadow .4s ease;
  will-change:transform,opacity;
  transform-origin:50% 60%;
}
.offer[data-slot="0"]{transform:translateX(0) scale(1) rotate(0deg);z-index:5;opacity:1;box-shadow:0 22px 48px rgba(14,26,56,.24)}
.offer[data-slot="-1"]{transform:translate(-62%,8px) scale(.86) rotate(-5deg);z-index:3;opacity:1}
.offer[data-slot="1"]{transform:translate(62%,8px) scale(.86) rotate(5deg);z-index:3;opacity:1}
.offer[data-slot="-2"]{transform:translate(-104%,16px) scale(.74) rotate(-9deg);z-index:1;opacity:0}
.offer[data-slot="2"]{transform:translate(104%,16px) scale(.74) rotate(9deg);z-index:1;opacity:0}
.offer[data-slot="hidden"]{transform:translateX(0) scale(.7);z-index:0;opacity:0}

/* real brand assets */
.offer-head > svg{width:auto;height:26px;max-width:132px;display:block}

.lender.real{background:#fff;overflow:hidden;padding:0}
.lender.real > svg{width:100%;height:100%;display:block}
.offer-head{
  height:52px;border-radius:10px;
  background:rgba(255,255,255,.80);   /* tints itself against each brand gradient */
  display:grid;place-items:center;padding:6px 8px;
}
.offer-body{padding:13px 8px 0;text-align:center;color:#fff}
.offer-body .rate-label{display:block;font-size:10.5px;font-weight:700;letter-spacing:.09em;opacity:.92}
.offer-body .rate{display:block;margin-top:2px;font-size:28px;font-weight:800;letter-spacing:-.02em;line-height:1.1}
.offer-body .rate .unit{margin-left:3px;font-size:13px;font-weight:700;letter-spacing:0;opacity:.92}
.offer-body .rule{height:1px;background:rgba(255,255,255,.35);margin:10px 6px}
.offer-body .upto-label{display:block;font-size:10.5px;font-weight:700;letter-spacing:.09em;opacity:.92}
.offer-body .upto{display:block;margin-top:1px;font-size:24px;font-weight:800;letter-spacing:-.02em}
.badge{
  display:inline-flex;align-items:center;gap:5px;
  margin-top:12px;padding:7px 13px;border-radius:999px;
  font-size:11.5px;font-weight:700;letter-spacing:0;
  background:rgba(255,255,255,.22);color:#fff;
}
.badge.best{background:rgba(255,255,255,.28);padding:9px 18px;font-size:12px}
.best-tag{
  position:absolute;top:-6px;right:-4px;
  padding:5px 12px;border-radius:999px;
  background:var(--brand);color:#fff;
  font-size:10px;font-weight:700;letter-spacing:.06em;
  box-shadow:0 6px 14px rgba(var(--brand-rgb),.35);
}
.offer[data-brand="lenderA"]{--grad:linear-gradient(135deg,#087F83 0%,#0CA77F 100%)}
.offer[data-brand="lenderB"]{--grad:linear-gradient(135deg,#E9B426 0%,#F4C139 100%)}
.offer[data-brand="lenderC"]{--grad:linear-gradient(135deg,#E8904E 0%,#ED802B 100%)}
.offer[data-brand="lenderD"]{--grad:linear-gradient(135deg,#3D4258 0%,#2E375C 100%)}
.offer[data-brand="lenderE"]{--grad:linear-gradient(135deg,#2E2E2E 0%,#3B3B3B 100%)}


.hero-amount{margin-top:16px;text-align:center}
.hero-amount .cap{font-size:14.5px;color:#5E6884;font-weight:400}
.hero-amount .big{
  margin:3px 0 5px;font-size:40px;font-weight:800;letter-spacing:-.03em;color:#0A1633;
}
.hero-amount .fine{font-size:13px;color:#98A0B5;font-weight:400}
.cta-primary{
  display:flex;align-items:center;justify-content:center;gap:12px;
  width:100%;margin-top:14px;padding:15px 20px;
  border-radius:var(--radius);background:var(--brand);color:var(--on-brand);
  font-size:18px;font-weight:700;letter-spacing:-.01em;
  box-shadow:0 12px 26px rgba(var(--brand-rgb),.32);
}
.cta-primary .circ{
  width:34px;height:34px;border-radius:50%;background:#fff;
  display:grid;place-items:center;flex:0 0 auto;
}
.hero .soft-note{margin:11px 0 0;text-align:center;font-size:13px;font-weight:600;color:#2B3550}

/* ---------- section 2 : calculator ---------- */
.calc{padding:14px 24px 8px;background:#FAFBFE;border-top:1px solid #EDF0F7}
.calc-top{display:flex;align-items:center;justify-content:space-between;gap:12px}
.calc-top h2{margin:0;font-size:24px;font-weight:800;letter-spacing:-.03em;color:#0A1633}

.emi-card{
  position:relative;overflow:hidden;
  margin-top:13px;padding:14px 16px;border-radius:20px;min-height:106px;
  display:flex;align-items:center;gap:2px;
  background:linear-gradient(105deg,var(--brand) 0%,var(--brand-light) 55%,var(--brand) 100%);
  box-shadow:0 12px 26px rgba(var(--brand-rgb),.24);
  color:#fff;
}
.emi-card svg.waves{position:absolute;right:-10px;top:0;height:100%;opacity:.3;pointer-events:none}
.emi-left{position:relative;z-index:1;flex:1 1 auto;min-width:0}
.emi-card .lbl{display:block;font-size:12.5px;font-weight:500;opacity:.94}
.emi-value{display:block;margin-top:1px;font-size:31px;font-weight:800;letter-spacing:-.03em;line-height:1.12}
.emi-tag{display:flex;align-items:center;gap:6px;margin-top:5px;font-size:12px;font-weight:500;opacity:.96}
.emi-art{position:relative;z-index:1;flex:0 0 auto;width:76px}
.emi-link{
  position:relative;z-index:1;flex:0 0 auto;
  display:flex;align-items:center;gap:6px;white-space:nowrap;
  padding:9px 13px;border-radius:999px;
  background:#fff;color:var(--brand);
  font-size:10.5px;font-weight:700;
  box-shadow:0 4px 12px rgba(var(--brand-rgb),.16);
}
.emi-link svg{flex:0 0 auto;width:13px;height:13px}

.calc h3{margin:14px 0 0;font-size:16px;font-weight:700;letter-spacing:-.02em;color:#0A1633}

/* lender rail */
.rail-wrap{position:relative;margin-top:9px}
.rail{
  display:flex;gap:4px;overflow-x:auto;scroll-behavior:smooth;
  padding:6px 24px;scroll-snap-type:x mandatory;
  scrollbar-width:none;
}
.rail::-webkit-scrollbar{display:none}
.lender-wrap{
  flex:0 0 auto;width:64px;scroll-snap-align:center;
  display:flex;flex-direction:column;align-items:center;gap:8px;
}
.lender{
  width:50px;height:50px;border-radius:50%;
  background:#fff;box-shadow:0 5px 14px rgba(14,26,56,.12);
  display:grid;place-items:center;
  font-weight:800;font-size:21px;letter-spacing:-.02em;
}
.lender.solid{color:#fff}
.lname{
  font-size:9.5px;line-height:1.24;font-weight:500;color:#3F4A5E;text-align:center;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;
}
.rail-nav[hidden]{display:none}
.rail-nav{
  position:absolute;top:31px;margin-top:-15px;z-index:4;
  width:30px;height:30px;border-radius:50%;background:#fff;
  box-shadow:0 4px 12px rgba(14,26,56,.14);display:grid;place-items:center;
}
.rail-nav.prev{left:-8px}
.rail-nav.next{right:-8px}
.dots{display:flex;justify-content:center;gap:6px;margin-top:8px}
.dots i{width:6px;height:6px;border-radius:50%;background:#D3DAE8;transition:background .2s,width .2s}
.dots i.on{background:var(--brand);width:8px;height:8px}
.rail-empty{
  padding:18px 20px;text-align:center;font-size:13.5px;color:var(--muted);
}

/* slider rows */
.panel{
  flex:0 0 auto;
  margin-top:12px;border-radius:18px;background:#fff;
  box-shadow:var(--shadow-card);padding:2px 16px;
}
.srow{display:flex;align-items:center;gap:14px;padding:10px 0}
.srow + .srow{border-top:1px solid #EEF1F7}
.sicon{
  width:44px;height:44px;border-radius:13px;flex:0 0 auto;
  background:var(--brand-tint);display:grid;place-items:center;
}
.sicon svg{width:22px;height:22px}
.sbody{flex:1 1 auto;min-width:0}
.slabel{display:block;font-size:12.5px;font-weight:600;color:#3F4A5E}
.svalue{display:block;font-size:20px;font-weight:800;letter-spacing:-.03em;color:#0A1633;line-height:1.26}
.hslider{position:relative;height:18px;margin-top:6px;touch-action:none;cursor:pointer}
.htrack{
  position:absolute;left:0;right:0;top:50%;height:4px;margin-top:-2px;
  border-radius:4px;background:#E3E8F2;cursor:pointer;
}
.hfill{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:var(--brand)}
.hknob{
  position:absolute;top:50%;width:18px;height:18px;margin:-9px 0 0 -9px;
  border-radius:50%;background:var(--brand);border:2.5px solid #fff;
  box-shadow:0 2px 6px rgba(var(--brand-rgb),.45);touch-action:none;
}
.hknob:focus-visible{outline:3px solid rgba(var(--brand-rgb),.4);outline-offset:3px}
.sends{display:flex;justify-content:space-between;margin-top:5px;font-size:11px;font-weight:500;color:#8A93A8}

.cta-apply{
  display:flex;align-items:center;justify-content:center;position:relative;
  width:100%;margin-top:12px;padding:15px 22px;border-radius:14px;
  background:var(--brand);color:#fff;font-size:16px;font-weight:700;letter-spacing:-.01em;
  box-shadow:0 12px 24px rgba(var(--brand-rgb),.26);
}
.cta-apply svg{position:absolute;right:22px;width:19px;height:13px}

.trust{display:flex;flex-direction:column;align-items:center;gap:9px;margin-top:16px}
.trust div{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:500;color:#4A5568;white-space:nowrap}
.trust div svg{width:15px;height:16px;flex:0 0 auto}
.trust .sep{display:none}

/* ---------- section 3 : soft credit slab ---------- */
.softsec{padding:28px 20px 26px;background:#FAFBFE}
.slab{
  border-radius:26px;background:var(--slab);
  padding:30px 26px 32px;text-align:center;
}
.slab .eyebrow{font-size:13px;font-weight:700;color:var(--orange);letter-spacing:-.01em}
.slab h2{
  margin:12px 0 0;font-size:29px;line-height:1.22;font-weight:800;
  letter-spacing:-.03em;color:#fff;
}
.slab .sub{margin:14px 0 0;font-size:14.5px;font-weight:600;color:var(--slab-sub)}
.slab .cta{
  display:block;width:100%;margin-top:22px;padding:17px;border-radius:var(--radius);
  background:var(--brand);color:var(--on-brand);font-size:17px;font-weight:700;letter-spacing:-.01em;
  box-shadow:0 12px 26px rgba(var(--brand-rgb),.28);
}
.slab-steps{
  list-style:none;margin:22px 0 0;padding:16px 0 0;
  display:grid;grid-template-columns:repeat(3,1fr);gap:8px;
  border-top:1px solid rgba(255,255,255,.12);
}
.slab-steps li{display:flex;flex-direction:column;align-items:center;min-width:0}
.slab-steps .n{
  width:28px;height:28px;border-radius:50%;display:grid;place-items:center;
  background:rgba(255,255,255,.1);color:#fff;font-size:12.5px;font-weight:800;
}
.slab-steps li:last-child .n{background:var(--brand);color:var(--on-brand)}
.slab-steps b{margin-top:8px;font-size:13px;font-weight:700;color:#fff;letter-spacing:-.01em}
.slab-steps em{margin-top:2px;font-style:normal;font-size:11px;line-height:1.35;color:var(--slab-sub)}
.lending-by{margin:22px 0 0;text-align:center;font-size:13.5px;color:#2B3550}
.lending-by b{font-weight:700}
.disclaimer{
  margin:10px auto 0;max-width:360px;text-align:center;
  font-size:12.5px;line-height:1.55;color:#9AA2B4;font-weight:400;
}

/* ---------- sticky drawer ---------- */
.drawer{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:min(100%,430px);z-index:70;
  padding:14px 18px calc(12px + env(safe-area-inset-bottom));
  flex-direction:column;align-items:stretch !important;gap:10px !important;
  background:rgba(255,255,255,.92);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-top:1px solid #E6EAF3;
  box-shadow:0 -10px 30px rgba(14,26,56,.08);
  display:flex;align-items:center;justify-content:space-between;gap:14px;
}
.drawer .grip{position:absolute;top:6px;left:50%;transform:translateX(-50%);width:38px;height:4px;border-radius:4px;background:#DBE1EC}
.dock-row{display:flex;align-items:center;justify-content:space-between;gap:14px}
/* off-screen while the hero's own button is on screen or still below it */
.drawer{transition:transform .32s cubic-bezier(.32,.72,.3,1)}
.drawer.away{transform:translate(-50%,110%);pointer-events:none}
.drawer .amt .cap{font-size:12.5px;font-weight:600;color:#7B8499;letter-spacing:.01em}
.drawer .amt .big{margin-top:1px;font-size:26px;font-weight:800;letter-spacing:-.03em;color:#0A1633;line-height:1.12}
.drawer .amt .tiny{margin-top:2px;font-size:11.5px;font-weight:600;color:#5E6884;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.drawer .amt .tiny b{color:var(--ink);font-weight:700}
.drawer .amt{min-width:0;transition:opacity .16s ease,transform .16s ease}
.drawer .amt .big,.drawer .amt .cap{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.drawer .amt .big small{font-size:13px;font-weight:600;color:#7B8499;letter-spacing:0;margin-left:2px}
.drawer.swap .amt,.drawer.swap .go span{opacity:0;transform:translateY(4px)}
.drawer .go span{transition:opacity .16s ease,transform .16s ease}
.drawer.bump .amt .big{animation:dockBump .38s ease}
@keyframes dockBump{40%{transform:scale(1.06);color:var(--brand)}}
.drawer .go{
  min-width:188px;justify-content:center;
  display:flex;align-items:center;gap:9px;flex:0 0 auto;
  padding:17px 22px;border-radius:var(--radius);background:var(--brand);color:var(--on-brand);
  font-size:16.5px;font-weight:700;box-shadow:0 10px 22px rgba(var(--brand-rgb),.3);
}

/* ---------- EMI breakup sheet ---------- */

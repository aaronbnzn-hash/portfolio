.pf-sec dd{margin:0;text-align:right;font-size:13.5px;font-weight:600;color:var(--ink);overflow-wrap:anywhere}
.pf-links{margin-top:14px;border-radius:18px;background:#fff;border:1.5px solid #EEF0F6;padding:0 16px}
.pf-links button{display:flex;align-items:center;width:100%;gap:12px;padding:15px 0;text-align:left;font-size:14.5px;font-weight:700;color:var(--ink)}
.pf-links button + button{border-top:1px solid #F1F3F8}
.pf-links button span{flex:1}
.pf-links button small{font-size:12.5px;font-weight:500;color:#8A93A8}
.pf-links button.pf-out{color:#C2410C}
.pf-note{display:flex;gap:10px;margin:14px 0 6px;padding:12px 14px;border-radius:14px;background:#F5F7FD;font-size:12.5px;line-height:1.5;color:#3F4A5E}
.pf-note svg{flex:none;margin-top:1px}
.pf-empty{display:none;margin-top:14px;padding:22px 18px;border-radius:18px;background:#F7F8FB;text-align:center;font-size:13.5px;line-height:1.5;color:#5A6478}
body.pf-new .pf-empty{display:block}
body.pf-new .pf-full{display:none}
/* edit mode: the header title replaces the form heading */
body.edit-on .j-view .f-head{display:none}
/* review before a repeat application */
.rv-sub{margin:10px 0 0;font-size:15px;line-height:1.55;color:#3F4A5E}
.pf-toast{position:absolute;left:50%;bottom:104px;z-index:150;transform:translate(-50%,16px);opacity:0;pointer-events:none;display:inline-flex;align-items:center;gap:8px;padding:11px 16px;border-radius:999px;background:#0E1A38;color:#fff;font-size:13.5px;font-weight:600;white-space:nowrap;transition:opacity .2s ease,transform .2s ease}
.pf-toast.on{opacity:1;transform:translate(-50%,0)}
.pf-toast i{display:grid;place-items:center;width:18px;height:18px;border-radius:50%;background:#16A34A;color:#fff}

/* empty wallet */
.we-wrap{text-align:center;padding:54px 6px 0}
.we-art{width:104px;height:104px;margin:0 auto;border-radius:32px;background:var(--brand-tint);display:grid;place-items:center}
.we-wrap h2{margin:22px 0 0;font-size:22px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
.we-wrap p{margin:10px auto 0;max-width:280px;font-size:14.5px;line-height:1.55;color:#6B7488}

/* application status */
.st-card{margin-top:18px;padding:26px 20px 18px;border-radius:20px;background:#fff;border:1.5px solid #EEF0F6;text-align:center}
.st-burst{position:relative;width:96px;height:96px;margin:0 auto}
.st-burst .ring{position:absolute;inset:0;border-radius:50%;background:#E8F8EF}
.st-burst .core{position:absolute;inset:16px;border-radius:50%;background:#16A34A;display:grid;place-items:center;color:#fff;font-size:26px;font-weight:800}
.st-burst i{position:absolute;width:6px;height:6px;border-radius:50%;animation:stPop 2.4s ease-in-out infinite}
@keyframes stPop{0%,100%{transform:scale(.6);opacity:.45}50%{transform:scale(1);opacity:1}}
.st-card h2{margin:18px 0 0;font-size:25px;font-weight:800;letter-spacing:-.03em;color:var(--ink)}
.st-line{margin:9px 0 0;font-size:14px;line-height:1.5;color:#5A6478}
.st-emi{margin:5px 0 0;font-size:14px;color:#5A6478}
.st-lender{display:flex;align-items:center;gap:12px;margin-top:18px;padding-top:16px;border-top:1px solid #F1F3F8;text-align:left}
.st-lender .lc-avatar{width:44px;height:44px}
.st-lender div{flex:1;min-width:0}
.st-lender b{display:block;font-size:16px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.st-lender span{display:block;margin-top:2px;font-size:12.5px;color:#7A8496}
.st-live{width:9px;height:9px;border-radius:50%;background:#16A34A;flex:0 0 auto}

.st-label{margin:22px 0 0;font-size:11px;font-weight:800;letter-spacing:.1em;color:#8A93A8}
.st-time{list-style:none;margin:11px 0 0;padding:16px 18px;border-radius:18px;background:#fff;border:1.5px solid #EEF0F6}
.st-time li{position:relative;display:flex;gap:14px;padding:0 0 22px}
.st-time li:last-child{padding-bottom:0}
.st-time li::before{content:"";position:absolute;left:13px;top:28px;bottom:2px;border-left:2px dashed #9BE0B8}
.st-time li:last-child::before{display:none}
.st-tic{width:27px;height:27px;border-radius:50%;flex:0 0 auto;background:#16A34A;display:grid;place-items:center;color:#fff;font-size:12px;font-weight:800}
.st-time b{display:block;font-size:14.5px;font-weight:700;color:var(--ink)}
.st-time div span{display:block;margin-top:3px;font-size:12.5px;color:#8A93A8}
.st-time em{font-style:normal;font-weight:700;color:#16A34A}

/* your loans */
.ln-lede{margin-top:18px}
.ln-grid .dash-side{flex:1 1 0}
.ln-grid .dash-mini{flex:1;display:flex;flex-direction:column}
.ln-grid .dash-mini .n{margin-top:auto;padding-top:14px}
.ln-row{
  display:flex;align-items:center;gap:12px;width:100%;text-align:left;
  margin-top:11px;padding:14px 15px;border-radius:16px;
  background:#fff;border:1.5px solid #EEF0F6;
}
.ln-row .lc-avatar{width:42px;height:42px}
.ln-row .nm{flex:1;min-width:0}
.ln-row .nm b{display:block;font-size:15.5px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.ln-row .nm i{display:block;margin-top:2px;font-style:normal;font-size:12.5px;color:#8A93A8}
.ln-row .amt{flex:0 0 auto;text-align:right}
.ln-row .amt i{display:block;font-style:normal;font-size:11px;color:#8A93A8}
.ln-row .amt b{display:block;margin-top:2px;font-size:15px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
button.ln-row:active{border-color:#D8DDEA;background:#FAFBFE}

/* the loan drawer */
.ln-sheet .hd{display:flex;align-items:center;gap:10px}
.ln-sheet .hd h3{flex:1;min-width:0}
.ln-close{width:28px;height:28px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;background:#F1F3F8}
.ln-facts{margin-top:6px}
.ln-facts > div{display:flex;align-items:center;gap:12px;padding:14px 0;border-bottom:1px solid #F1F3F8}
.ln-facts i{width:30px;height:30px;border-radius:9px;flex:0 0 auto;display:grid;place-items:center;background:var(--acct-soft)}
.ln-facts span{flex:1;min-width:0;font-size:14px;color:#5A6478}
.ln-facts b{font-size:15px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
.ln-full{
  display:flex;align-items:center;gap:10px;width:100%;margin-top:18px;
  padding:15px 16px;border-radius:13px;background:var(--acct-soft);color:var(--acct);
  font-size:14.5px;font-weight:700;
}
.ln-full svg:last-child{margin-left:auto}

/* loan interactions */
.hist-day{margin:22px 0 0;font-size:11px;font-weight:800;letter-spacing:.1em;color:#8A93A8}
.hist-card{margin-top:11px;padding:14px 15px;border-radius:16px;background:#fff;border:1.5px solid #EEF0F6}
.hist-hd{display:flex;align-items:center;gap:11px}
.hist-hd .lc-avatar{width:36px;height:36px}
.hist-hd b{flex:1;min-width:0;font-size:15px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.hist-chip{flex:0 0 auto;font-size:10.5px;font-weight:700;padding:5px 10px;border-radius:999px;white-space:nowrap}
.hist-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px 10px;margin-top:13px;padding-top:12px;border-top:1px solid #F1F3F8}
.hist-grid span{display:block;font-size:11px;color:#8A93A8}
.hist-grid b{display:block;margin-top:3px;font-size:13px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.hist-go{
  width:100%;margin-top:13px;padding:10px;border-radius:10px;
  border:1.5px solid var(--acct);color:var(--acct);font-size:13px;font-weight:700;
}
.hist-go:active{background:var(--acct-soft)}
.hist-foot{
  display:flex;align-items:flex-start;gap:8px;margin:22px 0 4px;
  font-size:11.5px;line-height:1.45;color:#98A0B5;
}
.hist-foot svg{flex:0 0 auto;margin-top:1px}
.hs-disb{color:#16A34A;background:#E8F8EF}
.hs-appr{color:var(--acct);background:var(--acct-soft)}
.hs-pend{color:var(--brand);background:var(--brand-tint)}
.hs-decl{color:#DC2626;background:#FDECEC}
.hist-grid b.hs-disb,.hist-grid b.hs-appr,.hist-grid b.hs-pend,.hist-grid b.hs-decl{background:none;padding:0}

/* dashboard */
.dash-h{margin:20px 0 0;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
.dash-sub{margin:3px 0 0;font-size:13.5px;color:#7A8496}
.dash-grid{display:flex;gap:11px;margin-top:13px}
.dash-total{
  flex:1 1 0;min-width:0;padding:15px 15px 14px;border-radius:16px;color:#fff;
  background:linear-gradient(155deg,var(--acct) 0%,var(--acct-deep) 100%);
  display:flex;flex-direction:column;
}
.dash-total .ic{width:30px;height:30px;border-radius:50%;background:rgba(255,255,255,.16);display:grid;place-items:center;font-size:14px;font-weight:700}
.dash-total .cap{margin-top:auto;padding-top:26px;font-size:11.5px;color:var(--acct-cap)}
.dash-total .big{margin-top:3px;font-size:21px;font-weight:800;letter-spacing:-.02em}
.dash-total .foot{margin-top:12px;font-size:10.5px;color:var(--acct-foot)}
.dash-side{flex:1.15 1 0;min-width:0;display:flex;flex-direction:column;gap:11px}
.dash-mini{padding:12px 13px;border-radius:16px;background:#fff;border:1.5px solid #EEF0F6}
.dash-mini .top{display:flex;align-items:center;justify-content:space-between;gap:6px}
.dash-mini .top span{font-size:11.5px;font-weight:600;color:#7A8496}
.dash-mini .n{margin-top:5px;font-size:20px;font-weight:800;letter-spacing:-.02em}
.dash-mini .n em{font-style:normal;font-size:12.5px;font-weight:600;color:#3F4A5E;margin-left:5px}
.dash-mini p{margin:1px 0 0;font-size:11px;color:#98A0B5}
.dash-mini button{margin-top:9px;width:100%;padding:6px 9px;border-radius:8px;font-size:11.5px;font-weight:700;text-align:left}
.dash-mini.pend .n{color:var(--brand)}
.dash-mini.pend button{background:var(--brand-tint);color:var(--brand)}
.dash-mini.disb .n{color:var(--acct)}
.dash-mini.disb button{background:var(--acct-soft);color:var(--acct)}

.dash-note{display:flex;align-items:flex-start;gap:11px;margin-top:13px;padding:13px 14px;border-radius:14px;background:var(--note)}
.dash-note b{display:block;font-size:12.8px;font-weight:700;color:var(--ink);line-height:1.4}
.dash-note p{margin:4px 0 0;font-size:12px;line-height:1.45;color:#6B7488}
.dash-note > svg:first-child{flex:0 0 auto;margin-top:1px}
.dash-note .q{flex:0 0 auto;margin-top:1px;opacity:.5}

.dash-secure{
  display:flex;align-items:center;justify-content:center;gap:7px;
  margin:16px 0 4px;font-size:11.5px;color:#8A93A8;
}
.dash-card{margin-top:12px;padding:15px 16px;border-radius:16px;background:#fff;border:1.5px solid #EEF0F6}
.dash-card .hd{display:flex;align-items:center;gap:11px}
.dash-card .lc-avatar{width:38px;height:38px}
.dash-card .hd b{flex:1;min-width:0;font-size:16px;font-weight:700;letter-spacing:-.02em;color:var(--ink)}
.dash-tag{flex:0 0 auto;font-size:11px;font-weight:700;color:var(--brand);background:var(--brand-tint);padding:5px 10px;border-radius:999px}
.dash-rows{margin-top:12px;display:flex;gap:12px;align-items:flex-end}
.dash-rows dl{flex:1;min-width:0;margin:0}
.dash-rows div{display:flex;gap:6px;font-size:12.8px;line-height:1.75}
.dash-rows dt{color:#3F4A5E;font-weight:700}
.dash-rows dd{margin:0;color:#7A8496}
.dash-go{
  flex:0 0 auto;padding:11px 15px;border-radius:10px;background:var(--acct);color:var(--on-brand);
  font-size:13px;font-weight:700;
}

/* ---------- the offer that comes back from the lender ---------- */
body.offer-on .j-head{display:none}

.lo-head{
  display:flex;align-items:center;gap:10px;margin:6px -6px 0;
}
.lo-back{width:34px;height:34px;flex:0 0 auto;display:grid;place-items:center}
.lo-brand{flex:1;min-width:0;text-align:center}
.lo-brand span{display:block;font-size:11.5px;font-weight:500;color:#8A93A8}
.lo-brand .mark{display:flex;justify-content:center;margin-top:3px}
.lo-brand .mark svg{height:15px;width:auto;max-width:120px;display:block}
.lo-help{flex:0 0 auto;font-size:14px;font-weight:700;color:var(--brand)}

.lo-amt{
  margin-top:16px;padding:18px 18px 16px;border-radius:16px;
  background:var(--brand-tint);text-align:center;
}
.lo-amt .cap{font-size:13px;font-weight:500;color:#8A6A57}
.lo-amt .big{
  margin-top:4px;font-size:33px;font-weight:800;letter-spacing:-.03em;
  color:var(--ink);font-variant-numeric:tabular-nums;
}
.lo-slider{position:relative;height:24px;margin-top:14px;touch-action:none;cursor:pointer}
.lo-track{position:absolute;left:0;right:0;top:50%;height:4px;margin-top:-2px;border-radius:4px;background:#F3D9CB}
.lo-fill{position:absolute;left:0;top:0;bottom:0;border-radius:4px;background:var(--brand)}
.lo-knob{
  position:absolute;top:50%;width:26px;height:26px;margin:-13px 0 0 -13px;border-radius:50%;
  background:var(--brand);display:grid;place-items:center;
  box-shadow:0 4px 12px rgba(var(--brand-rgb),.4);
}
.lo-ends{display:flex;justify-content:space-between;margin-top:6px;font-size:12px;color:#8A6A57}

.lo-note{
  display:flex;align-items:center;gap:10px;margin-top:12px;padding:13px 14px;
  border-radius:12px;background:#fff;border:1.5px solid #EEF0F6;
  font-size:12.8px;color:#3F4A5E;
}
.lo-note svg{flex:0 0 auto}

.lo-h{margin:22px 0 0;font-size:17.5px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
.lo-opts{margin-top:12px;display:flex;flex-direction:column;gap:11px}
.lo-opt{
  display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;
  padding:15px 16px;border-radius:15px;background:#fff;
  border:1.5px solid #E7EAF1;transition:border-color .18s ease,background .18s ease;
}
.lo-opt.on{border-color:var(--brand);background:var(--brand-tint)}
.lo-radio{
  width:20px;height:20px;flex:0 0 auto;margin-top:2px;border-radius:50%;
  border:2px solid #CBD2E0;display:grid;place-items:center;transition:border-color .18s ease;
}
.lo-opt.on .lo-radio{border-color:var(--brand)}
.lo-radio i{width:10px;height:10px;border-radius:50%;background:var(--brand);transform:scale(0);transition:transform .18s ease}
.lo-opt.on .lo-radio i{transform:scale(1)}
.lo-opt-b{flex:1;min-width:0;display:block}
.lo-emi{display:block;font-size:19px;font-weight:800;letter-spacing:-.02em;color:var(--ink)}
.lo-emi em{font-style:normal;font-size:14px;font-weight:500;color:#7A8496;margin:0 4px}
.lo-emi b{font-size:14.5px;font-weight:700;color:var(--brand)}
.lo-rate{display:block;margin-top:4px;font-size:12.5px;color:#8A93A8}

/* ---------- the hand-off lender's own app, rebuilt for Nivaan Finserv ---------- */
.lj{display:none;padding:0;pointer-events:none;user-select:none;-webkit-user-select:none}
.lj-img{
  display:block;width:auto;max-width:100%;
  max-height:calc(100dvh - 195px);   /* status bar + header + footer */
  margin:0 auto;
}
@media (min-width:1080px){
  .lj-img{max-height:calc(100dvh - 106px)}   /* no footer at rail widths */
}
.lj-site{
  display:flex;align-items:center;justify-content:center;gap:6px;
  width:max-content;margin:12px auto 0;padding:6px 14px;border-radius:999px;
  background:#EEF1F6;font-size:11px;font-weight:600;color:#5A6478;
}
.lj.is-on{display:block;animation:jIn .26s ease}
.lj-top{display:flex;align-items:center;justify-content:space-between;padding:14px 2px 0}
.lj-top .doc{width:30px;height:30px;border-radius:9px;background:var(--acct-soft);display:grid;place-items:center}
.lj-logo{height:19px;width:auto;display:block}

.lj-bar{display:flex;align-items:flex-start;margin:16px 0 4px}
.lj-bar li{position:relative;flex:1;list-style:none;text-align:center}
.lj-bar li::before{content:"";position:absolute;top:6px;left:-50%;right:50%;height:2px;background:#DDE4F2}
.lj-bar li:first-child::before{display:none}
.lj-bar li.done::before,.lj-bar li.now::before{background:var(--lj)}
.lj-bar i{position:relative;z-index:1;display:block;width:13px;height:13px;margin:0 auto;border-radius:50%;background:#DDE4F2}
.lj-bar li.done i{background:var(--lj)}
.lj-bar li.now i{background:#fff;box-shadow:0 0 0 3.5px var(--lj)}
.lj-bar em{display:block;margin-top:7px;font-style:normal;font-size:9.5px;font-weight:600;color:#98A0B5;white-space:nowrap}
.lj-bar li.done em,.lj-bar li.now em{color:var(--lj)}

.lj h2{margin:20px 0 0;font-size:22px;font-weight:800;letter-spacing:-.03em;line-height:1.24;color:#12224A}
.lj .sub{margin:8px 0 0;font-size:13.5px;line-height:1.5;color:#6B7488}
.lj .lab{margin:18px 0 7px;font-size:12.5px;font-weight:600;color:#5A6478}
.lj .fld{
  display:flex;align-items:center;gap:9px;background:#F6F8FC;border:1.5px solid var(--acct-line);
  border-radius:11px;padding:0 13px;height:48px;font-size:14.5px;color:#12224A;font-weight:600;
}
.lj .fld.ghost{color:#A3ADC2;font-weight:500}
.lj .fld .cc{color:#8A93A8;font-weight:500}
.lj .pf{
  flex:0 0 auto;margin-left:auto;display:inline-flex;align-items:center;gap:5px;
  font-size:9px;font-weight:800;color:var(--lj);background:var(--acct-soft-2);padding:3px 8px;border-radius:999px;
}
.lj .two{display:flex;gap:10px}
.lj .two > div{flex:1;min-width:0}

.lj-pick{
  display:flex;align-items:flex-start;gap:11px;padding:14px;border-radius:13px;
  background:#fff;border:1.6px solid var(--acct-line);margin-top:11px;
}
.lj-pick.on{border-color:var(--lj);background:#F4F8FF}
.lj-pick .ic{width:34px;height:34px;flex:0 0 auto;border-radius:10px;background:var(--acct-soft-2);display:grid;place-items:center}
.lj-pick b{display:block;font-size:14px;font-weight:700;color:#12224A}
.lj-pick span{display:block;margin-top:3px;font-size:11.8px;line-height:1.4;color:#7A8496}

.lj-amt{
  margin-top:18px;padding:22px 18px;border-radius:18px;text-align:center;color:#fff;
  background:linear-gradient(150deg,var(--acct-mid) 0%,var(--lj) 100%);
}
.lj-amt .cap{font-size:10.5px;font-weight:800;letter-spacing:.14em;opacity:.86}
.lj-amt .big{margin-top:8px;font-size:40px;font-weight:800;letter-spacing:-.03em}
.lj-chips{display:flex;flex-wrap:wrap;gap:7px;justify-content:center;margin-top:14px}
.lj-chips span{font-size:10.5px;font-weight:700;color:var(--acct-mid);background:var(--acct-soft-2);padding:6px 11px;border-radius:999px}
.lj-more{display:flex;align-items:center;gap:11px;margin-top:14px;padding:13px 14px;border-radius:13px;background:#F2F6FE}
.lj-more b{display:block;font-size:13px;font-weight:700;color:#12224A}
.lj-more span{display:block;margin-top:2px;font-size:11.5px;color:#7A8496}

.lj-hero{margin:24px auto 0;width:84px;height:84px;border-radius:50%;display:grid;place-items:center}
.lj-hero.ok{background:#E8F8EF}
.lj-hero.info{background:var(--acct-soft-2)}
.lj-mid{text-align:center}
.lj-mid h2{margin-top:18px}

.lj-list{margin:16px 0 0;padding:0;list-style:none}
.lj-list li{display:flex;gap:10px;align-items:flex-start;padding:7px 0;font-size:13px;color:#3F4A5E;line-height:1.45}
.lj-list i{flex:0 0 auto;margin-top:1px}

.lj-note{display:flex;gap:9px;align-items:flex-start;margin-top:16px;padding:12px 13px;border-radius:11px;background:#F2F6FE;font-size:11.8px;line-height:1.45;color:#5A6478}
.lj-note svg{flex:0 0 auto;margin-top:1px}

.lj-doc{margin-top:16px;border:1.5px solid var(--acct-line);border-radius:13px;overflow:hidden;background:#fff}
.lj-doc .hd{display:flex;align-items:center;gap:8px;padding:11px 13px;background:#F6F8FC;font-size:12px;font-weight:700;color:#12224A}
.lj-doc .pg{padding:13px;font-size:8.6px;line-height:1.7;color:#B4BCCC}
.lj-doc .pg b{display:block;color:#7A8496;font-size:9.4px;margin-bottom:5px}


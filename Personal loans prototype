}
.j-status .icons{display:flex;align-items:center;gap:6px}

.j-head{display:flex;align-items:flex-start;gap:6px;padding:10px 18px 4px;flex:0 0 auto}
.j-back{width:34px;height:34px;display:grid;place-items:center;flex:0 0 auto;margin-top:2px}

.stepper[hidden]{display:none}
.stepper{display:flex;align-items:flex-start;flex:1;list-style:none;margin:0;padding:0 4px 0 16px;border-left:1.5px solid #EAECF0}

.kfs-sum span{display:block;font-size:11px;font-weight:500;color:#98A0B5;white-space:nowrap}
.kfs-sum b{display:block;margin-top:7px;font-size:15px;font-weight:700;color:#0F1E33;white-space:nowrap}
.kfs-lender{margin-top:7px;display:grid;place-items:center;height:19px}

}
.prail-pre[hidden]{display:none}
.prail-count{margin-top:16px;font-size:13px;font-weight:600;color:#7A8496}
.prail-count b{font-size:22px;font-weight:800;color:var(--ink);letter-spacing:-.02em}
.prail-track{margin-top:10px;height:3px;border-radius:3px;background:#DCE0EA;overflow:hidden}
.prail-track i{display:block;height:100%;width:0;border-radius:3px;background:var(--brand);transition:width .22s ease}
.prail-btns{display:flex;gap:9px;margin-top:16px}
.prail-btns button{

}
.stepper em{margin-top:8px;font-size:13px;font-style:normal;font-weight:500;color:#8A93A5}
.stepper .is-active .dot,.stepper .is-done .dot{background:var(--orange);border-color:var(--orange);color:#fff}
.stepper .is-active em,.stepper .is-done em{color:#0F1E33;font-weight:600}
.stepper .is-done + li::before{background:var(--orange)}

/* real brand mark inside the lender-card avatar */
.lc-avatar.real{background:#fff !important;overflow:hidden;padding:0;box-shadow:0 2px 8px rgba(14,26,56,.12)}
.lc-avatar.real > svg{width:100%;height:100%;display:block}

/* ---------- theme lab ---------- */
.hero > .hero-lab{

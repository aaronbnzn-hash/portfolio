}
.kfs-note i{flex:0 0 auto;margin-top:1px}
.kfs-note p{margin:0;font-size:12.5px;line-height:1.45;color:#5A6478}

.j-main{flex:1 1 auto;overflow-y:auto;-webkit-overflow-scrolling:touch;padding:0 28px}
.j-view{display:none}
.j-view.is-on{display:block;animation:jIn .28s ease}
@keyframes jIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

.j-view h1{margin:58px 0 0;font-size:30px;font-weight:800;letter-spacing:-.03em;line-height:1.22}
.j-view .j-sub{margin:14px 0 0;font-size:16px;line-height:1.55;color:#3F4A5E;font-weight:400}
.j-label{margin:34px 0 12px;font-size:14px;font-weight:600;color:#7A8496}
.j-field{
  display:flex;align-items:center;gap:14px;

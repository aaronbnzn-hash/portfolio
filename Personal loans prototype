  const LO_STEP = 5000, LO_FLOOR = 25000;
  const LO_TENURES = [12, 24, 36, 48, 60];
  const LO = { amount: 0, min: LO_FLOOR, max: 0, tenure: 0 };

  function loPlans(){
    const l = J.lender;
    const ok = LO_TENURES.filter(t => t >= l.tmin && t <= l.tmax);
    if (!ok.length) return [l.tmax];
    const primary = ok.reduce((a, b) => Math.abs(b - state.tenure) < Math.abs(a - state.tenure) ? b : a, ok[0]);
    const shorter = ok.filter(t => t < primary).pop();
    const longer = ok.filter(t => t > primary)[0];
    const second = shorter !== undefined ? shorter : longer;
    return second !== undefined ? [primary, second] : [primary];
  }

  function loPaint(){
    const l = J.lender;
    document.getElementById('loAmt').textContent = inr(LO.amount);
    document.getElementById('loMin').textContent = inr(LO.min);
    document.getElementById('loMax').textContent = inr(LO.max);
    const f = LO.max > LO.min ? (LO.amount - LO.min) / (LO.max - LO.min) : 1;
    document.getElementById('loFill').style.width = (f * 100) + '%';
    document.getElementById('loKnob').style.left = (f * 100) + '%';
    document.getElementById('loKnob').setAttribute('aria-valuenow', LO.amount);
    document.getElementById('loKnob').setAttribute('aria-valuetext', inr(LO.amount));

    const monthly = (l.rate / 12).toFixed(2);
    document.getElementById('loOpts').innerHTML = loPlans().map(t => `
      <button type="button" class="lo-opt${t === LO.tenure ? ' on' : ''}" data-t="${t}">
        <span class="lo-radio"><i></i></span>
        <span class="lo-opt-b">
          <span class="lo-emi">${inr(emi(LO.amount, t, l.rate))}<em>for</em><b>${t} months</b></span>
          <span class="lo-rate">@ ${monthly}% average monthly interest</span>
        </span>

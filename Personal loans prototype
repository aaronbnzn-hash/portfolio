}
.kfs-zoom button{font-size:17px;font-weight:600;color:#5A6478;line-height:1;width:14px}
.kfs-zoom button:disabled{opacity:.32}
.kfs-zoom span{font-size:12px;font-weight:600;color:#0F1E33;min-width:34px;text-align:center;font-variant-numeric:tabular-nums}
.kfs-note{
